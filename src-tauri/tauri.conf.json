{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Voice Agent",
  "version": "0.1.0",
  "identifier": "com.desktopvoiceagent.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "Desktop Voice Agent",
        "width": 400,
        "height": 300,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  },
  "plugins": {
    "globalShortcut": {
      "shortcuts": []
    },
    "notification": {
      "identifier": "com.desktopvoiceagent.app"
    },
    "shell": {
      "open": true,
      "scope": []
    }
  }
}
